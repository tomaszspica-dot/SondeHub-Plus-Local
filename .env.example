# SondeHub+ configuration example
#
# Copy/edit these values for your installation.
# Do not commit a real .env file containing private configuration.

# HTTP port.
SONDEHUB_PLUS_PORT=8093

# Safe default: listen only on this computer.
SONDEHUB_PLUS_BIND=127.0.0.1

# To allow access from a trusted LAN:
# SONDEHUB_PLUS_BIND=0.0.0.0

# Your SondeHub listener/station callsign.
SONDEHUB_LISTENER_CALLSIGN=YOUR_CALLSIGN

# Radiosonde Watch backend.
RADIOSONDE_WATCH_URL=http://127.0.0.1:8092


# Optional endpoint exposing the current local receiver state.
# It should provide fields such as:
#   received_serials
#   state
#   auto_rx_running
#
# Example:
# RADIOSONDE_WATCH_LOCAL_ENDPOINT=/api/local-receiver

# radiosonde_auto_rx installation directory.
RADIOSONDE_AUTO_RX_DIR=~/radiosonde_auto_rx

# SondeHub API.
SONDEHUB_API_URL=https://api.v2.sondehub.org

# Optional:
# SONDEHUB_PLUS_USER_AGENT=RadiosondeWatch-SondeHubPlus/1.1
